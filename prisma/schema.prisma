generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  TEAM_LEAD
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED

  /// Removed by an admin, but the row stays.
  ///
  /// This is an attendance and payroll product: a user's rows are the evidence
  /// behind who was paid for which hours. Most jurisdictions require those
  /// records kept for years after someone leaves, so a real DELETE — which
  /// cascades their attendance away with them — destroys the one thing that
  /// settles a dispute.
  ///
  /// Carried on UserStatus rather than a separate `deletedAt IS NULL` filter
  /// because JwtStrategy already refuses anyone whose status is not ACTIVE.
  /// That means a deleted user is locked out of every authenticated route the
  /// moment this commits, with no new filter for a future endpoint to forget.
  DELETED
}

model PendingOrganizationSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Organization {
  id        String   @id @default(uuid())

  /// The address the organization signed up with. Still unique — it is what
  /// stops one inbox owning two organizations by accident.
  email     String   @unique

  /// Deliberately NOT unique.
  ///
  /// It was, which meant the first customer to register "Sterling Ltd" took
  /// that name away from every other company of the same name, worldwide, with
  /// no recourse for the second one but to invent a name they do not trade
  /// under. Duplicate company names are ordinary — Companies House alone lists
  /// many — and nothing here needs the name to be a key: organizations are
  /// addressed by `id` everywhere, tenants never see each other, and sign-in is
  /// by email or employee ID, never by organization name.
  name      String
  industry  String?

  /// IANA zone name, e.g. "Africa/Lagos". Phase 3 decision 1: one per
  /// organisation, with a per-office override possible later.
  ///
  /// Every "which day is this?" question is answered in this zone, and nothing
  /// else. Timestamps stay UTC; this only decides where midnight falls. Without
  /// it, a 00:30 Lagos clock-in lands on the previous day's summary, and an
  /// 08:05 arrival is judged against 08:00 UTC — an hour off.
  ///
  /// Not CHECK-constrained: Postgres cannot validate a zone name in a CHECK
  /// (the lookup is not immutable). The API validates with Intl before writing.
  timezone  String   @default("Africa/Lagos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  departments Department[]
  offices     Office[]
  auditLogs   AuditLog[]

  workRules           WorkRule[]
  holidays            Holiday[]
  punchEvents         PunchEvent[]
  attendanceSummaries AttendanceSummary[]
}

model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees User[]

  @@unique([organizationId, name])
}

model Office {
  id                   String   @id @default(uuid())
  name                 String
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Int      @default(100)
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])

  /// The rule this office's staff are judged against. Null = the
  /// organisation's default rule (Phase 3 decision 2).
  ///
  /// SetNull on delete, so removing a rule drops the office back to the
  /// default rather than refusing the delete or leaving a dangling id.
  workRuleId           String?
  workRule             WorkRule? @relation(fields: [workRuleId], references: [id], onDelete: SetNull)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employees User[]

  @@unique([organizationId, name])
  @@index([workRuleId])
}

model User {
  id           String     @id @default(uuid())
  employeeId   String     @unique
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(PENDING)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  officeId     String?
  office       Office?    @relation(fields: [officeId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// When the account was removed. Null for everyone else.
  ///
  /// `status` drives the behaviour; this records the date, which is what a
  /// retention policy is actually written against ("destroy seven years after
  /// leaving"). updatedAt cannot serve — any later edit overwrites it.
  deletedAt    DateTime?

  /// Consecutive failed sign-ins, reset to zero by any successful one.
  ///
  /// Counted per *account*, which is the unit that matters and the one IP
  /// throttling cannot see: a thousand addresses each trying five passwords
  /// against one account stays under every per-IP limit ever written.
  failedLoginAttempts Int @default(0)

  /// Set when the count crosses the threshold; sign-in is refused until it
  /// passes.
  ///
  /// Deliberately a timestamp rather than a boolean `locked`. A lockout that
  /// needs an administrator to clear it turns a wrong password typed five
  /// times into a support ticket, and — worse — hands anyone who knows an
  /// employee's email a way to keep them out of the system indefinitely.
  /// Expiry makes the attack cost an attacker continuous effort and costs the
  /// employee fifteen minutes.
  lockedUntil DateTime?

  refreshToken       RefreshToken[]
  activationTokens   ActivationToken[]
  passwordResetToken PasswordResetToken[]

  punchEvents         PunchEvent[]
  attendanceSummaries AttendanceSummary[]

  /// Postgres indexes a primary key and a UNIQUE column automatically. It does
  /// NOT index a foreign key. All three below were sequential scans of the
  /// whole users table — invisible at 50 rows, and the first thing to fall over
  /// at 100,000.
  ///
  /// organizationId: every admin's user list (UsersService.findAll).
  ///
  /// departmentId: a TEAM_LEAD's user list. No composite with organizationId is
  /// needed — a department belongs to exactly one organization, so filtering on
  /// it is already at least as selective as filtering on both.
  ///
  /// officeId: not read by any query today. It is here for deletes: removing an
  /// Office makes Postgres check every User row for references, and without an
  /// index that check is a full scan holding a lock. The same applies to
  /// departmentId, which the index above also covers.
  @@index([organizationId])
  @@index([departmentId])
  @@index([officeId])
}

/// Append-only record of who did what, and when.
///
/// For a product holding attendance and pay data this is not a feature, it is
/// what makes the system defensible: when a former employee disputes their
/// hours or an admin denies suspending someone, this table is the answer. There
/// is deliberately no update or delete path anywhere in the code, and
/// TokenCleanupService does not touch it — audit rows outlive the records they
/// describe, and should be kept for as long as the payroll data they explain.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// Null for actions the system takes on its own — a scheduled job, or the
  /// automated punch flagging Phase 3 adds.
  actorId        String?

  /// The actor and target as they read AT THE TIME, not a join done later.
  ///
  /// This is the whole discipline of an audit trail. People get renamed,
  /// change role, and leave; resolving names at read time would make a
  /// three-year-old entry describe today's org chart rather than what actually
  /// happened. Storing the label costs a few bytes and keeps the record true.
  actorName      String
  actorRole      UserRole?

  /// e.g. USER_SUSPENDED. A string rather than a Prisma enum on purpose:
  /// Phase 3 adds CLOCK_IN, PUNCH_APPROVED, DEVICE_REVOKED and more, and an
  /// enum would mean a database migration for each one. The write side is
  /// still type-safe — see AuditAction in audit.service.ts.
  action         String

  targetType     String?
  targetId       String?
  targetLabel    String?

  /// Nullable because it is not always knowable — behind a proxy without
  /// TRUST_PROXY_HOPS set, Express reports the proxy rather than the caller,
  /// and a wrong address in an audit trail is worse than none.
  ipAddress      String?

  createdAt      DateTime @default(now())

  /// Every read is "this organization's entries, newest first", which is
  /// exactly what this composite serves.
  @@index([organizationId, createdAt])
}

// ─── Phase 3: attendance ────────────────────────────────────────────────────
//
// Plan and the six decisions behind these models:
// docs/phase-notes/phase-3-attendance-plan.md
//
// The shape in one line: PunchEvent is the evidence and never changes;
// AttendanceSummary is arithmetic over it and can always be rebuilt; WorkRule
// and Holiday are the inputs to that arithmetic.

/// When people are expected to work. Several per organisation, exactly one of
/// them the default (Phase 3 decision 2).
///
/// Times are minutes after local midnight in the organisation's timezone —
/// 08:00 is 480. Integers rather than "08:00" strings so the database can
/// enforce start < end and compare them, and so nothing parses a string in
/// the middle of payroll arithmetic. The API converts at the edge.
///
/// **Exactly one default per organisation** is enforced by a partial unique
/// index in the migration (`WHERE "isDefault"`). Prisma's schema language
/// cannot express a partial index, so it lives only in SQL — do not "tidy" it
/// away because it is missing here.
model WorkRule {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  isDefault Boolean @default(false)

  /// ISO weekdays, 1 = Monday … 7 = Sunday. A day not listed is a rest day:
  /// no lateness, and no absence if nobody clocks in.
  workingDays Int[]

  startMinutes Int
  /// CHECK end > start in the migration — Phase 3 decision 5, no overnight
  /// shifts in the MVP. Lifting that is a deliberate change, not a data edit.
  endMinutes   Int

  /// FR-006: lateness counts from the END of the grace period. Start 480,
  /// grace 10, arrival 493 → 3 minutes late, not 13.
  gracePeriodMinutes Int @default(0)

  /// Worked minutes in a day beyond which the rest is overtime. Null = this
  /// rule does not track overtime.
  overtimeAfterMinutes Int?

  /// Pay multiplier for overtime. Stored because onboarding already collects
  /// it; nothing in Phase 3 uses it — payroll is Phase 5. Decimal, never Float:
  /// it ends up multiplied into money.
  overtimeMultiplier Decimal @default(1.5) @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices   Office[]
  summaries AttendanceSummary[]

  @@unique([organizationId, name])
}

enum HolidayType {
  PUBLIC
  COMPANY
}

/// A day nobody is expected to work. An organisation-wide calendar for now;
/// per-office holidays can come with per-office timezones.
model Holiday {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String

  /// A calendar date in the organisation's timezone — no time, no zone.
  date DateTime @db.Date

  type HolidayType @default(PUBLIC)

  /// Matches the same month and day in every year (New Year's Day). False for
  /// holidays that move (Eid, Easter), which have to be entered each year.
  repeatsAnnually Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, date, name])
  @@index([organizationId, date])
}

enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

/// One attendance action, exactly as it happened. The evidence everything else
/// is computed from (PRTS §12: "Punch Events are immutable").
///
/// **Append-only, enforced by the database.** A trigger in the migration
/// rejects every UPDATE and DELETE on this table, so the guarantee does not
/// rest on nobody ever writing an update route. A mistaken punch is answered
/// by a new punch, never by editing the old one — a pay dispute is settled by
/// what was recorded at the time.
///
/// TRUNCATE is not blocked (row triggers do not fire on it), which keeps the
/// e2e reset working. Nothing in the application truncates.
model PunchEvent {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// Restrict, not Cascade: users are soft-deleted (UserStatus.DELETED), and a
  /// hard delete must never be able to take their attendance with it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type PunchType

  /// When it happened, from the SERVER's clock. Nothing the browser sends is
  /// ever used as the time — a client clock is set by the person being timed.
  ///
  /// The service passes this explicitly, from the same instant it uses to
  /// compute workDate, so the two can never disagree across a midnight. The
  /// default is a backstop only.
  occurredAt DateTime @default(now())

  /// The local calendar date this punch belongs to, in the organisation's
  /// timezone at the time of the punch. Stored, not derived at read time:
  /// if the organisation later changes timezone, history must not move days.
  workDate DateTime @db.Date

  /// Where the browser said it was — recorded, not enforced (Phase 3
  /// decision 6). FR-010 needs location on every attendance event; Phase 4's
  /// geo-fence check will read these. Null when the browser refused location.
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?

  createdAt DateTime @default(now())

  /// "This user's punches today, in order" — the state-machine read on every
  /// punch, and the summary recompute.
  @@index([userId, workDate, occurredAt])
  /// Organisation-wide day views (Phase 5 reports, the end-of-day job).
  @@index([organizationId, workDate])
}

enum AttendanceStatus {
  /// Clocked in at least once.
  PRESENT
  /// A working day under the rule, not a holiday, and no clock-in — set by
  /// the end-of-day job, never by a punch.
  ABSENT
  ON_HOLIDAY
  /// Not one of the rule's working days.
  REST_DAY
}

/// One row per person per local day, derived from that day's PunchEvents.
///
/// **Derived and rebuildable — never the source of truth.** Recomputed inside
/// each punch's transaction by a pure function of (punches, rule, timezone,
/// holiday). If the arithmetic is ever wrong, fix the function and recompute;
/// the punches are untouched. That is why this table may be updated and
/// PunchEvent may not.
///
/// All durations are whole minutes. Breaks are SUBTRACTED from workedMinutes
/// (Phase 3 decision 3 — pending management confirmation; the rule lives in
/// the summary function only, so changing it is one line plus a recompute).
model AttendanceSummary {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  workDate DateTime @db.Date
  status   AttendanceStatus

  firstClockIn DateTime?
  lastClockOut DateTime?

  workedMinutes   Int @default(0)
  breakMinutes    Int @default(0)
  overtimeMinutes Int @default(0)

  isLate      Boolean @default(false)
  lateMinutes Int     @default(0)

  /// Clocked in with no matching clock-out when the day closed (Phase 3
  /// decision 4). The day is left open and flagged — a clock-out is never
  /// invented, because an inferred punch is a fabricated record.
  isIncomplete Boolean @default(false)

  /// The rule as it stood when this day was computed. A snapshot, not just a
  /// pointer: if HR moves the start time from 08:00 to 09:00 in March, a
  /// January recompute must still judge January against 08:00.
  workRuleId            String?
  workRule              WorkRule? @relation(fields: [workRuleId], references: [id], onDelete: SetNull)
  scheduledStartMinutes Int?
  scheduledEndMinutes   Int?
  gracePeriodMinutes    Int?

  computedAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, workDate])
  @@index([organizationId, workDate])
  @@index([workRuleId])
}

/// Issued when an admin provisions a user. The raw token is handed to the
/// invitee; only its SHA-256 hash is stored here, so a leak of this table
/// does not yield usable tokens.
model ActivationToken {
  id        String    @id @default(uuid())

  /// Still unique — this is what completeRegistration looks a redeemed link up
  /// by, and two users must never share one.
  tokenHash String    @unique

  /// Deliberately NOT unique.
  ///
  /// It was, which capped every user at one activation token for their entire
  /// existence and made "re-send invitation" impossible to build — while
  /// provision's own failure message already told admins to do exactly that.
  /// An invitation that is lost, expires after 7 days, or lands in spam left
  /// the account permanently stranded in PENDING with no way forward except
  /// deleting and recreating the person.
  ///
  /// One row per invitation sent, so the history of who was invited and when
  /// survives. Superseded tokens are retired by stamping usedAt rather than
  /// deleted, which is the same single-use check completeRegistration already
  /// applies.
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Was implicit in the dropped @unique. Still needed: every lookup and the
  /// delete cascade go through userId.
  @@index([userId])
}

/// Stores only the SHA-256 hash of each refresh token, never the token itself,
/// so a leak of this table yields nothing directly usable.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Every token descended from one sign-in shares this id. Rotation carries it
  /// forward, so a chain of tokens stays identifiable as one session.
  ///
  /// It exists for theft detection: when a token that was already rotated is
  /// presented again, the safe response is to end that whole session, not just
  /// refuse the one request — the holder has a token the rightful owner also
  /// had, and there is no way to tell which of the two is asking. Revoking the
  /// family logs both out and forces a real sign-in.
  familyId  String

  expiresAt DateTime
  revoked   Boolean  @default(false)

  /// Set only when `revoked` was caused by ROTATION — this token was spent
  /// normally and replaced by its successor.
  ///
  /// The distinction is the whole mechanism. A token revoked with rotatedAt
  /// still null was ended deliberately (sign-out, suspension, password reset)
  /// and presenting it again is unremarkable. A token revoked WITH rotatedAt
  /// was spent, so a second presentation is either the owner's other tab
  /// racing within the grace window, or someone replaying a stolen copy. The
  /// timestamp is what separates those two.
  rotatedAt DateTime?

  createdAt DateTime @default(now())

  /// Unindexed, these two columns were sequential scans over a table that grows
  /// with every rotation — `userId` for sign-out-everywhere and suspension,
  /// `familyId` for the theft response above.
  @@index([userId])
  @@index([familyId])

  /// For the cleanup sweep (TokenCleanupService), which selects expired rows
  /// every six hours. This is much the largest of the token tables — one row
  /// per refresh, so ~96 per active user per day — and without this the sweep
  /// is a full scan of exactly the table it exists to keep small. The other
  /// token tables are low-volume enough that a scan is cheaper than carrying
  /// an index on every write.
  @@index([expiresAt])
}

/// Issued by POST /auth/forgot-password. Same hashed-at-rest, single-use,
/// time-limited design as ActivationToken.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Read by forgotPassword, which retires any unused token for the user before
  /// issuing a new one, and walked again by the cascade when a user is deleted.
  @@index([userId])
}