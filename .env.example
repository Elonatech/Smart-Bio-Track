# Copy to .env and fill in. Every REQUIRED value must be set or the API
# refuses to boot — see apps/api/src/env.validation.ts.
#
# Leave optional variables OUT rather than blank. The schema marks them
# .optional(), which permits the variable being absent but not an empty
# string, so APP_WEB_URL="" fails validation where omitting the line entirely
# is fine.


# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------

# Neon "development" branch. connect_timeout=30 matters — Neon suspends idle
# branches and the first query after a cold start is slow.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"

# Neon "test" branch — required only to run the integration tests, which
# TRUNCATE every table between tests. Point it at a branch you are happy to
# lose, and never at the same database as DATABASE_URL. See commands.md.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-HOST.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"


# ---------------------------------------------------------------------------
# Auth (REQUIRED)
# ---------------------------------------------------------------------------

# Two DIFFERENT long random strings. Reusing one value for both means a
# refresh token would also pass as an access token.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"

# Optional. Default to 15m / 7d if omitted.
# JWT_ACCESS_EXPIRY="15m"
# JWT_REFRESH_EXPIRY="7d"


# ---------------------------------------------------------------------------
# Email — Brevo (REQUIRED)
# ---------------------------------------------------------------------------
#
# Without these two the API will not start. Org verification, staff activation
# and password reset all send real mail, and the tokens are no longer returned
# in API responses, so there is no way to complete those flows without them.
#
# Two things that are easy to miss:
#  - New Brevo accounts have "Authorised IPs" ON. Any call from an unlisted IP
#    gets a 401 that mentions the IP, not your key or sender:
#    https://app.brevo.com/security/authorised_ips
#  - BREVO_SENDER_EMAIL must be added AND verified under Senders, Domains &
#    Dedicated IPs. Brevo matches it literally, so a plus-tagged address and
#    its plain form count as two different senders.

BREVO_API_KEY="xkeysib-replace-me"
BREVO_SENDER_EMAIL="noreply@example.com"

# Optional. Shown as the From name; defaults to "SmartBioTrack".
# BREVO_SENDER_NAME="SmartBioTrack"

# Optional. Where replies go, if not the sender address.
# BREVO_REPLY_TO_EMAIL="support@example.com"

# Optional. Comma-separated; blind-copied on every outgoing email.
# BREVO_BCC_RECIPIENTS="archive@example.com,ops@example.com"


# ---------------------------------------------------------------------------
# Application (optional)
# ---------------------------------------------------------------------------

# The FRONTEND origin — this is what the links in our emails point at, not the
# API's own address. Defaults to http://localhost:3000 (where `next dev`
# serves; the API itself runs on PORT below). Must be set in any deployed
# environment or verification links will send users to their own machine.
APP_WEB_URL="http://localhost:3000"

# API port. Defaults to 3000 if omitted, which collides with the frontend —
# hence 8000 locally.
PORT=8000

# Comma-separated allowed origins for CORS.
# CORS_ORIGINS="http://localhost:3000"

# How many reverse proxies sit in front of the API. Set to 1 behind a proxy
# (Render, Nginx) so rate limiting keys off the real client IP instead of
# putting every user in one bucket. Leave unset (0) when directly exposed:
# trusting X-Forwarded-For while reachable lets an attacker forge it and mint
# unlimited rate-limit buckets. See apps/api/src/env.validation.ts.
# TRUST_PROXY_HOPS=1
