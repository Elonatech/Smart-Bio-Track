{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      // Build the workspace packages first. They ship compiled JavaScript
      // (`main: dist/index.js`) rather than raw TypeScript — deliberately, see
      // packages/types/tsconfig.json — so without this a fresh clone or a new
      // branch starts `next dev` against a dist/ that does not exist yet, and
      // the failure reads as a missing module rather than a missing build step.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}